# Browser-safe Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only marketplace connection
# Never prefix these values with NEXT_PUBLIC_ and never expose them in client code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Temporary pilot protection for admin-only marketplace endpoints.
# Replace this with authenticated admin roles before wider production use.
MARKETPLACE_ADMIN_API_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Controlled marketplace routing
# Set to false to stop automatic first-wave creation without removing the code.
MARKETPLACE_AUTOROUTING_ENABLED=true

# Vercel sends this value as `Authorization: Bearer <CRON_SECRET>` to cron routes.
# Required before scheduled wave expansion is enabled in production.
CRON_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# Existing AI integrations
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GOOGLE_AI_KEY
