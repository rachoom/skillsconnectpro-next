# Browser-safe Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only marketplace connection
# Never prefix these values with NEXT_PUBLIC_ and never expose them in client code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferred for new Supabase projects. Use this or the legacy service-role key below.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Temporary pilot protection for admin-only marketplace endpoints.
# Replace this with authenticated admin roles before wider production use.
MARKETPLACE_ADMIN_API_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Controlled marketplace routing
# Set to false to stop automatic first-wave creation without removing the code.
MARKETPLACE_AUTOROUTING_ENABLED=true

# Customer completion confirmation period.
# After this many hours with no customer confirmation or support case,
# the operational project record closes automatically. Verified ratings stay locked
# until the customer personally confirms completion.
MARKETPLACE_COMPLETION_GRACE_HOURS=72

# Vercel sends this value as `Authorization: Bearer <CRON_SECRET>` to cron routes.
# Required before scheduled routing and completion processing are enabled in production.
CRON_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# Existing AI integrations
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GOOGLE_AI_KEY

# Provider invitation delivery.
# Keep manual for the funding-window prototype: the dashboard prepares secure links,
# then the admin opens WhatsApp and taps Send manually. No paid Meta template delivery
# runs unless both MARKETPLACE_WHATSAPP_DELIVERY_MODE=automatic and
# MARKETPLACE_WHATSAPP_AUTO_SEND=true are set.
MARKETPLACE_WHATSAPP_DELIVERY_MODE=manual
MARKETPLACE_WHATSAPP_AUTO_SEND=false
MARKETPLACE_PUBLIC_URL=https://www.skillsconnectpro.co.za
META_WHATSAPP_GRAPH_API_VERSION=SET_CURRENT_SUPPORTED_VERSION
META_WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
META_WHATSAPP_ACCESS_TOKEN=YOUR_PERMANENT_SYSTEM_USER_TOKEN
META_WHATSAPP_TEMPLATE_NAME=provider_job_invitation
META_WHATSAPP_TEMPLATE_LANGUAGE=en
META_WHATSAPP_APP_SECRET=YOUR_META_APP_SECRET
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
